# Copy to .env for local runs (never commit .env). On Hugging Face, set these in
# Space Settings > Variables and secrets instead. BOTH are optional — the app is
# fully functional with no keys (Open-Meteo is free and the field is bundled).

# OPTIONAL — natural-language advisory phrasing in an Indian language.
# Free key: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OPTIONAL — live vegetation imagery instead of the bundled sample field.
# Free key: https://agromonitoring.com/api
AGRO_API_KEY=
